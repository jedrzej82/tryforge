# E2E Test Environment Variables
# Copy this file to .env.test and fill in your values

# Base URLs
BASE_URL=http://localhost:3000
ADMIN_PANEL_URL=http://localhost:3333

# Test User Credentials
TEST_EMAIL=test@example.com
TEST_PASSWORD=password123

# API Keys (for testing generated apps with AI features)
ANTHROPIC_API_KEY=your_claude_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Test Configuration
HEADLESS=true
SLOW_MO=0
TIMEOUT=30000

# CI Environment
CI=false

# Browser Configuration
BROWSER=chromium # chromium, firefox, webkit, or all

# Screenshot & Video Settings
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true
TRACE_ON_FAILURE=true

# Test Data
TEST_DATA_DIR=./tests/e2e/fixtures
