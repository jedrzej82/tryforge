# TryForge Environment Variables
#
# Copy this file to .env and fill in your values
# Environment variables take precedence over config files

# Node Environment
NODE_ENV=development

# General Settings
TRYFORGE_LOG_LEVEL=info

# AI Service Configuration
TRYFORGE_AI_PROVIDER=claude
TRYFORGE_AI_API_KEY=sk-ant-your-api-key-here
TRYFORGE_AI_MODEL=claude-3-sonnet-20240229
TRYFORGE_AI_MAX_TOKENS=4096
TRYFORGE_AI_TEMPERATURE=0.7
TRYFORGE_AI_TIMEOUT=30000

# Database Configuration
TRYFORGE_DATABASE_PROVIDER=postgresql
TRYFORGE_DATABASE_HOST=localhost
TRYFORGE_DATABASE_PORT=5432
TRYFORGE_DATABASE_NAME=tryforge
TRYFORGE_DATABASE_USERNAME=postgres
TRYFORGE_DATABASE_PASSWORD=your-password-here
TRYFORGE_DATABASE_SSL=false

# Alternative: Database URL Format
# TRYFORGE_DATABASE_URL=postgresql://username:password@host:port/database

# Template Settings
TRYFORGE_TEMPLATES_AUTO_UPDATE=true

# Project Settings
TRYFORGE_PROJECT_DEFAULT_TEMPLATE=react-typescript
TRYFORGE_PROJECT_DEFAULT_DATABASE=postgresql
TRYFORGE_PROJECT_INCLUDE_TESTS=true
TRYFORGE_PROJECT_GIT_INIT=true

# CLI Settings
TRYFORGE_CLI_INTERACTIVE=true
TRYFORGE_CLI_VERBOSE=false
TRYFORGE_CLI_COLOR=true

# Generation Settings
TRYFORGE_GENERATE_FILE_CASE=kebab
TRYFORGE_GENERATE_IMPORT_STYLE=named
TRYFORGE_GENERATE_QUOTES=single
TRYFORGE_GENERATE_SEMICOLONS=true

# Server Settings (optional)
PORT=3000
