# Test Environment Configuration
NODE_ENV=test
PORT=3001

# Test Database
DATABASE_URL="postgresql://test:test@localhost:5433/test_db?schema=public"

# JWT (use different secrets for testing)
JWT_SECRET=test-jwt-secret-key-for-testing-min-32-characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=test-refresh-secret-key-for-testing-min-32
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3001

# Rate Limiting (more lenient for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging (less verbose in tests)
LOG_LEVEL=error
LOG_FILE_PATH=logs/test

# Security
BCRYPT_ROUNDS=1
