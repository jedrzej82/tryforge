# TryForge Environment Configuration
# Copy this file to .env and fill in your values

# ===================================
# CORE CONFIGURATION
# ===================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ===================================
# AI SERVICES (Optional - TryForge works without these)
# ===================================

# Claude API (for AI code generation)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=

# GitHub Token (for GitHub Spark UI generation)
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=

# OpenAI API (alternative AI provider)
# Get from: https://platform.openai.com/
OPENAI_API_KEY=

# ===================================
# DATABASE CONFIGURATION
# ===================================

# PostgreSQL (Required)
DATABASE_URL=postgresql://tryforge_user:password@localhost:5432/tryforge

# Redis (Required for jobs, cache, analytics)
REDIS_URL=redis://localhost:6379

# MongoDB (Optional)
MONGODB_URI=mongodb://localhost:27017/tryforge

# ===================================
# EXTERNAL SERVICES (All Optional)
# ===================================

# Email (SendGrid)
SENDGRID_API_KEY=

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# File Storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=tryforge-storage

# Payment Processing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# ===================================
# BLOCKCHAIN (Optional - for Web3 features)
# ===================================
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
POLYGON_RPC_URL=https://polygon-rpc.com
WALLET_PRIVATE_KEY=

# ===================================
# MONITORING (Optional)
# ===================================
SENTRY_DSN=
GA_TRACKING_ID=

# ===================================
# SECURITY (Generate random strings)
# ===================================

# Generate with: openssl rand -base64 32
JWT_SECRET=your-very-long-random-secret-here
SESSION_SECRET=another-long-random-secret-here

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here

# ===================================
# FEATURE FLAGS
# ===================================
ENABLE_VISUAL_EDITOR=true
ENABLE_WORKFLOW_BUILDER=true
ENABLE_AGENCY_TOOLS=true
ENABLE_AI_CODE_GEN=true
ENABLE_CONVERSATIONAL_AI=true
