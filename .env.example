# TryForge Environment Variables Example
# Copy this file to .env and update with your values

# Database Configuration
DATABASE_URL=postgresql://devuser:devpass123@localhost:5432/tryforge_db
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass123

# Redis Configuration (optional - for caching)
REDIS_URL=redis://localhost:6379

# GitHub Configuration (for Spark automation)
GITHUB_USERNAME=your-github-username
GITHUB_EMAIL=your-email@example.com

# Pollinations AI
POLLINATIONS_BASE_URL=https://image.pollinations.ai

# AI Provider Selection
# Choose: "claude" or "openrouter"
AI_PROVIDER=claude

# Claude Configuration
# Choose auth mode: "api" for API Key or "subscription" for Claude Pro/Max tokens
CLAUDE_AUTH_MODE=api

# API Key mode (pay-per-use via Anthropic API)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Subscription mode (Claude Pro/Max - use your subscription tokens)
CLAUDE_SESSION_TOKEN=sessKey-ant-your-session-token-here
CLAUDE_ORGANIZATION_ID=

# OpenRouter Configuration (Access to multiple free AI models)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Default model (minimax/minimax-01 is free!)
OPENROUTER_MODEL=minimax/minimax-01

# Deployment Platforms (optional - for automated deployment)
VERCEL_TOKEN=your-vercel-token-here
NETLIFY_TOKEN=your-netlify-token-here
RAILWAY_TOKEN=your-railway-token-here
RENDER_API_KEY=your-render-api-key-here

# Development Settings
NODE_ENV=development
LOG_LEVEL=info

# Playwright Settings
PLAYWRIGHT_HEADLESS=false   # Set to true to hide browser during automation

# Port Configuration
FRONTEND_PORT=5173
BACKEND_PORT=3000
PREVIEW_PORT=4000

# Application Settings
APP_NAME=TryForge
APP_VERSION=1.0.0
