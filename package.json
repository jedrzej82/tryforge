    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.5",
    "joi": "^17.11.0",
    "js-beautify": "^1.14.11",
