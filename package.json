{
  "name": "tryforge",
  "version": "1.0.0",
  "description": "Triple AI Application Framework - Create production-ready apps in minutes using Claude + GitHub Spark + Pollinations AI",
  "main": "src/cli/index.js",
  "bin": {
    "tryforge": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js",
    "dev": "nodemon src/cli/index.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:unit:watch": "jest tests/unit --watch",
    "test:unit:coverage": "jest tests/unit --coverage",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:watch": "jest --config jest.integration.config.js --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:coverage": "jest --coverage",
    "test:coverage:unit": "jest tests/unit --coverage",
    "test:coverage:report": "open coverage/lcov-report/index.html",
    "test:coverage:text": "jest --coverage --coverageReporters=text",
    "test:watch": "jest --watch",
    "test:watchAll": "jest --watchAll",
    "test:verbose": "jest --verbose",
    "test:silent": "jest --silent",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:ci:unit": "jest tests/unit --ci --coverage --maxWorkers=2",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:clear": "jest --clearCache",
    "test:badges": "node scripts/generate-badges.js",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "ai",
    "automation",
    "code-generation",
    "claude",
    "github-spark",
    "pollinations",
    "web-development",
    "react",
    "express",
    "postgresql"
  ],
  "author": "TryForge Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@faker-js/faker": "^8.3.1",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "execa": "^8.0.1",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "handlebars": "^4.7.8",
    "inquirer": "^8.2.5",
    "joi": "^17.11.0",
    "js-beautify": "^1.14.11",
    "jsonwebtoken": "^9.0.2",
    "markdown-it": "^14.0.0",
    "nodemailer": "^6.9.7",
    "ora": "^5.4.1",
    "pg": "^8.11.3",
    "playwright": "^1.40.1",
    "redis": "^4.6.11",
    "sharp": "^0.33.5",
    "socket.io": "^4.5.4",
    "socket.io-client": "^4.5.4",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.5",
    "axe-playwright": "^1.2.3",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jedrzej82/tryforge.git"
  },
  "bugs": {
    "url": "https://github.com/jedrzej82/tryforge/issues"
  }
}
